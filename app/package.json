{
  "name": "nous",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:veritas": "node scripts/dev/veritas-server.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "tauri": "tauri",
    "assets": "node scripts/fetch-assets.mjs",
    "tauri:user": "cross-env VITE_USER_MODE=true tauri dev",
    "test:ui": "node scripts/tests/ui-smoke.mjs",
