{
  "name": "nous",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "tauri": "tauri",
    "assets": "node scripts/fetch-assets.mjs",
    "tauri:user": "cross-env VITE_USER_MODE=true tauri dev",
    "test:data": "cd src-tauri && cargo test --lib replay -- --nocapture",
    "game:login": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev/hsr-session.ps1 login",
    "game:logout": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev/hsr-session.ps1 logout",
    "game:relogin": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev/hsr-session.ps1 relogin"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^10.1.0",
    "oxlint": "^1.89.0",
    "sharp": "^0.35.5",
    "subset-font": "^2.9.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
